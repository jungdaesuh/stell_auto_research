# Copy this file to .env and fill in your paths.
# Do NOT commit .env — it contains machine-specific paths.

# Path to SIMSOPT repository root (contains examples/single_stage_optimization/)
SIMSOPT_ROOT=/path/to/your/simsopt

# Python interpreter with SIMSOPT and dependencies installed
SIMSOPT_PYTHON=/path/to/conda/envs/simsopt/bin/python

# Directory containing equilibrium wout_*.nc files
EQUILIBRIA_DIR=/path/to/equilibria

# --- Optional: artifact & directory layout ---
# Scratch dir for live solver runs. Crashed runs always leave their dir
# (with run.log) here for debugging.
#OUTPUT_BASE=/tmp/stellarator_harness

# Archive of Stage 2 seeds that single-stage warm-starts from.
#STAGE2_SEED_DIR=/absolute/path/to/stage2_seeds

# Retention for a completed run's solver outputs (plots, coil JSONs, logs):
#   none = discard after ingest (default), pass = keep passing runs, all = keep every completed run
#KEEP_ARTIFACTS=none

# Where kept run dirs are moved, named by run id (matches results.db id).
#ARTIFACTS_DIR=/absolute/path/to/artifacts

# --- Optional: solver script locations (relative to SIMSOPT_ROOT) ---
# Only set these if your simsopt fork keeps the solver scripts at
# different paths than the defaults below.
#STAGE2_SCRIPT=examples/single_stage_optimization/STAGE_2/banana_coil_solver.py
#SINGLE_STAGE_SCRIPT=examples/single_stage_optimization/SINGLE_STAGE/single_stage_banana_example.py
#POINCARE_SCRIPT=examples/single_stage_optimization/POINCARE_PLOTTING/poincare_surfaces.py
